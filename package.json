    "@vitejs/plugin-react": "^6.2.1",
    "firebase-tools": "^15.34.2",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
